# Copy to .env.local and fill in. All values here are optional — the site
# builds and runs without them (analytics are simply disabled, and the site
# URL falls back to the production domain).

# Canonical site URL, used for SEO canonicals, Open Graph URLs, and the sitemap.
# Defaults to https://husanisomiddinov.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics measurement ID (G-XXXXXXXXXX). Analytics scripts only load
# when this is set.
NEXT_PUBLIC_GA_ID=

# PostHog project API key. Product analytics only initialize when this is set.
NEXT_PUBLIC_POSTHOG_API_KEY=
